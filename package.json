        "lint:lychee": "lychee --config node_modules/lychee-config-nick2bad4u/lychee.toml --exclude \"^https?:\\/\\/nick2bad4u\\.github\\.io/$\" --exclude \"^https?:\\/\\/dashboard\\.stryker-mutator\\.io/api/reports/?$\" .",
