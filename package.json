        "lint:css:fix": "npx stylelint --cache --config stylelint.config.mjs --cache-strategy content --cache-location .cache/stylelintcache src/ docs/ --fix && echo \"Stylelint done!\"",
        "lint:depcheck": "npm run knip -- --dependencies",
        "lint:deps": "npm run lint:depcheck && npm run knip",
